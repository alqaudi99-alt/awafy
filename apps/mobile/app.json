{
  "expo": {
    "name": "Awafy عوافي",
    "slug": "awafy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "awafy",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "net.ethraamed.awafy",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Awafy needs access to your photos so you can upload a prescription.",
        "NSCameraUsageDescription": "Awafy uses the camera so you can photograph a prescription."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.ethraamed.awafy"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006A58",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ar",
              "en"
            ],
            "android": [
              "ar",
              "en"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Awafy needs access to your photos so you can upload a prescription."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
